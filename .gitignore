# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
coverage
lcov.info
test-results
playwright-report
blob-report

__pycache__

# Optional debug dump from .github/scripts/build_rules_json.py.
# Builds read shared/rules/*.json directly.
/shared/rules.json

# Optional debug dump from .github/scripts/build_lint_settings_yaml.py.
# Builds read the per-setting JSON files directly.
/shared/configuration/lint-settings.generated.yaml

# Generated by app/scripts/generate-config-types.mjs from
# shared/rules/*.json and shared/configuration/lint-settings/*.json
/app/src/config-types.ts

# Optional on-disk copy from .github/scripts/generate_default_config.py.
# papyrus-lint-config/build.rs renders this into $OUT_DIR itself.
/shared/configuration/papyrus-lint.default.yaml

# Optional on-disk copy from .github/scripts/generate_config_schema.py.
# Pages renders the schema while building the site.
/schema/papyrus-lint.schema.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
