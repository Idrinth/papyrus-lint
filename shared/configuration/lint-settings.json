{
  "project_settings": [
    {
      "key": "compiler_path",
      "yaml_default": "null",
      "yaml_comment": "Path to PapyrusCompiler.exe, o",
      "schema": {
        "description": "Path to PapyrusCompiler.exe, or null/omit to auto-detect it.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    {
      "key": "additional_script_roots",
      "yaml_default": "[]",
      "yaml_comment": "Extra directories (relative to",
      "schema": {
        "description": "Extra directories (relative to the project root, or absolute) to search for .psc files, besides scripts/source and source/scripts. Used for linting, cross-script resolution, and the compiler -i path.",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": []
      }
    },
    {
      "key": "lookup_script_roots",
      "yaml_default": "[]",
      "yaml_comment": "Extra directories searched onl",
      "schema": {
        "description": "Extra directories searched only as a fallback when resolving other scripts for analysis (argument/return types, Extends, autocompletion). Scripts found only here are never linted, and these directories are ignored by conflicting-script-versions.",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": []
      }
    },
    {
      "key": "compile_check",
      "yaml_default": "false",
      "yaml_comment": "true, false; also runs Papyrus",
      "schema": {
        "description": "Also run PapyrusCompiler.exe (into a throwaway temporary directory) as part of linting a .psc, reporting its errors alongside the lint engine. Requires compiler_path to be set or auto-detected.",
        "type": "boolean",
        "default": false
      }
    },
    {
      "key": "strict_achlist_scope",
      "yaml_default": "false",
      "yaml_comment": "true enables strict cross-scri",
      "schema": {
        "description": "When true, restrict cross-script resolution and conflicting-script-versions to an achlist's listed entries only. When false (the default), parent directories of listed entries are also search roots.",
        "type": "boolean",
        "default": false
      }
    }
  ],
  "rules_yaml_comment": "Each rule accepts true or false",
  "rule_order": [
    "line_length",
    "trailing_whitespace",
    "final_newline",
    "comma_spacing",
    "forbidden_functions",
    "deprecated_functions",
    "formid_hex_notation",
    "get_form_from_file_skyrim_esm",
    "get_form_from_file_load_index",
    "slow_functions",
    "unused_getter",
    "unused_nodiscard",
    "unused_property",
    "semicolon",
    "float_int_conversion",
    "int_division_to_float",
    "strict_boolean",
    "argument_types",
    "return_types",
    "function_override",
    "argument_naming",
    "argument_override_types",
    "numeric_comparison",
    "indentation",
    "cyclomatic_complexity",
    "unreachable_statement",
    "static_condition",
    "redundant_condition",
    "unreachable_elseif",
    "division_by_zero",
    "empty_body",
    "empty_event_handler",
    "duplicate_conditional_body",
    "unused_local_variable",
    "variable_used_before_assignment",
    "none_form_usage",
    "member_chain_none_usage",
    "local_variable_shadowing",
    "parameter_reassignment",
    "chain_whitespace",
    "exclamation_spacing",
    "identifier_casing",
    "type_casing",
    "named_arguments",
    "operator_spacing",
    "assignment_operator_spacing",
    "property_sorting",
    "explicit_return",
    "unchecked_form_parameter",
    "unchecked_array_element",
    "unchecked_cast",
    "useless_downcast",
    "impossible_cast",
    "unresolved_script",
    "non_global_function_call",
    "member_access",
    "register_for_update_in_on_update",
    "static_function_call_via_instance",
    "short_wait_interval",
    "state_function_signature",
    "goto_state",
    "get_state_comparison",
    "unused_state",
    "too_many_states",
    "multiple_auto_states",
    "conflicting_script_versions",
    "stale_compiled_output",
    "script_filename_mismatch",
    "unused_disable",
    "magic_numbers",
    "native_function_usage",
    "repeated_getvalue",
    "global_variable_setvalue",
    "global_variable_increment",
    "setvalue_in_loop",
    "invariant_loop_condition",
    "script_name_collision",
    "array_bounds",
    "array_size_range",
    "array_used_before_new",
    "readonly_property_write",
    "default_property_value",
    "unguarded_self_recursion",
    "self_assignment",
    "debug_side_effects",
    "unnecessary_function",
    "unknown_actor_value",
    "repeated_setoutfit",
    "place_at_me",
    "missing_doc_comment",
    "invalid_random_range",
    "float_equality",
    "missing_update_handler",
    "unused_import",
    "event_signature_mismatch",
    "circular_dependency",
    "undefined_event",
    "boolean_simplification"
