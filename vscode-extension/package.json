{
  "name": "papyrus-lint-vscode",
  "displayName": "Papyrus Lint",
  "description": "Lints Bethesda Papyrus (.psc) scripts using PapyrusLinterCLI.",
  "version": "0.1.0",
  "publisher": "idrinth",
  "icon": "logo.jpg",
  "license": "MIT",
  "homepage": "https://papyrus-lint.idrinth.de/",
  "repository": {
    "type": "git",
    "url": "https://github.com/idrinth/papyrus-lint.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:papyrus",
    "onLanguage:yaml",
    "workspaceContains:**/papyrus-lint.yml",
    "workspaceContains:**/papyrus-lint.yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "papyrus",
        "extensions": [
          ".psc"
        ],
        "aliases": [
          "Papyrus"
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/papyrus-lint.yml",
          "**/papyrus-lint.yaml"
        ],
        "url": "https://papyrus-lint.idrinth.de/schema/papyrus-lint.schema.json"
      }
    ],
    "configuration": {
      "title": "Papyrus Lint",
      "properties": {
        "papyrusLint.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a PapyrusLinterCLI executable. Its --version output must match the extension version. When empty, the extension downloads and uses the CLI from its matching GitHub release, including after the extension itself is updated."
        },
        "papyrusLint.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to a papyrus-lint config file to use instead of the one PapyrusLinterCLI would otherwise discover from the project root. Leave empty to use the default discovery."
        },
        "papyrusLint.liveLint": {
          "type": "boolean",
          "default": true,
          "description": "Lint a Papyrus document's current, possibly unsaved contents as you type (via PapyrusLinterCLI's --blob flag), in addition to linting it on open/save. Turn off to only lint on open/save."
        },
        "papyrusLint.liveLintDebounceMs": {
          "type": "number",
          "default": 400,
          "description": "How long to wait, in milliseconds, after the last keystroke in a Papyrus document before running a live lint of its current contents."
        }
      }
    },
    "commands": [
      {
        "command": "papyrusLint.lintFile",
        "title": "Papyrus Lint: Lint Current File",
        "category": "Papyrus Lint"
      },
      {
        "command": "papyrusLint.fixFile",
        "title": "Papyrus Lint: Fix Current File",
        "category": "Papyrus Lint"
      },
      {
        "command": "papyrusLint.fixIssue",
        "title": "Papyrus Lint: Fix This Issue",
        "category": "Papyrus Lint"
      },
      {
        "command": "papyrusLint.initializeConfig",
        "title": "Papyrus Lint: Initialize Configuration",
        "category": "Papyrus Lint"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "papyrusLint.lintFile",
          "when": "editorLangId == papyrus"
        },
        {
          "command": "papyrusLint.fixFile",
          "when": "editorLangId == papyrus"
        },
        {
          "command": "papyrusLint.fixIssue",
          "when": "false"
        },
        {
          "command": "papyrusLint.initializeConfig"
        }
      ],
      "editor/context": [
        {
          "command": "papyrusLint.lintFile",
          "when": "editorLangId == papyrus",
          "group": "papyrusLint"
        },
        {
          "command": "papyrusLint.fixFile",
          "when": "editorLangId == papyrus",
          "group": "papyrusLint"
        }
      ],
      "explorer/context": [
        {
          "command": "papyrusLint.lintFile",
          "when": "resourceExtname == .psc",
          "group": "papyrusLint"
        },
        {
          "command": "papyrusLint.fixFile",
          "when": "resourceExtname == .psc",
          "group": "papyrusLint"
        },
        {
          "command": "papyrusLint.initializeConfig",
          "when": "explorerResourceIsFolder",
          "group": "papyrusLint"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 test/*.test.mjs",
    "test:coverage": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=90 --test-reporter=tap --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "eslint": "^10.9.1",
    "globals": "^15.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0"
  }
}
