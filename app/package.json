{
  "name": "papyrus-lint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:config-types": "node ./scripts/generate-config-types.mjs",
    "prepare": "node ./scripts/generate-config-types.mjs",
    "dev": "npm run generate:config-types && vite",
    "build": "npm run generate:config-types && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run generate:config-types && vitest run",
    "test:coverage": "npm run generate:config-types && vitest run --coverage",
    "test:browser": "npm run generate:config-types && playwright test",
    "lint": "npm run generate:config-types && eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \"../shared/**/*.css\""
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  }
}
